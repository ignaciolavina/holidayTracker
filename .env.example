# holidayTracker — variables de entorno. Copia a `.env` (desarrollo) o defínelas en Railway (producción).
# Los valores de abajo son los de desarrollo; los comentarios indican qué poner en producción.

# Entorno: development | production | test. En production son obligatorias JWT_SECRET y MONGODB_URI.
NODE_ENV=development

# Puerto HTTP. Railway lo inyecta solo; no lo definas allí.
PORT=3000

# Cadena de conexión de MongoDB. Si se deja vacía (solo desarrollo) arranca un Mongo en memoria con seed.
# En producción debe ser un REPLICA SET (la app usa transacciones): Railway Mongo con --replSet o Atlas.
# Ejemplo: mongodb://usuario:clave@mongo.railway.internal:27017/holidaytracker?replicaSet=rs0&authSource=admin
MONGODB_URI=

# Secreto para firmar los JWT (mínimo 32 caracteres aleatorios). Obligatorio en producción.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# URL pública de la app, sin barra final. Se usa en los enlaces de los emails (invitaciones, aprobaciones).
APP_URL=http://localhost:5173

# Origen permitido por CORS. Vacío = solo mismo origen (lo normal en producción, porque el servidor sirve el front).
# En desarrollo con Vite: http://localhost:5173
CORS_ORIGIN=

# Cookies con flag Secure. Por defecto true en producción y false en desarrollo. Exige HTTPS.
COOKIE_SECURE=false

# Transporte de email: console (escribe en MAIL_DIR y en el log) | smtp | resend.
MAIL_TRANSPORT=console

# Remitente de los emails.
MAIL_FROM="holidayTracker <no-reply@holidaytracker.local>"

# Solo si MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true para TLS implícito (puerto 465); false para STARTTLS (587)
SMTP_SECURE=false

# Solo si MAIL_TRANSPORT=resend
RESEND_API_KEY=

# Tareas programadas (cierre de año, caducidades, recordatorios, escalado). true por defecto salvo en tests.
# Con varias réplicas es seguro: los jobs usan un lock distribuido en Mongo (colección jobLocks).
CRON_ENABLED=true

# Rate limiting de la API y del login. true por defecto salvo en tests.
RATE_LIMIT_ENABLED=true

# Carga los datos de ejemplo si la base de datos está vacía. true por defecto fuera de producción.
# EN PRODUCCIÓN DEBE SER false.
SEED_ON_EMPTY=true

# API de festivos (Nager.Date).
NAGER_BASE_URL=https://date.nager.at

# Carpeta (relativa al directorio de trabajo del servidor) donde el transporte `console` guarda los emails .html.
MAIL_DIR=tmp/mails

# Zona horaria del proceso. Las fechas de negocio se calculan en Europe/Madrid.
TZ=Europe/Madrid
